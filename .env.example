# ─────────── نسخ إلى .env أو اضبطها في لوحة تحكم الاستضافة ───────────
# انسخ هذا الملف: cp .env.example .env  (لا ترفع .env إلى Git)

# مطلوب لتوليد التقارير النصية
GEMINI_API_KEY=

# اختياري: اسم النموذج (gemini-2.5-flash افتراضياً)
GEMINI_MODEL=gemini-2.5-flash

# 0 = إيقاف التفكير العميق (أسرع وأرخص). -1 = إعداد النموذج الافتراضي
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_OUTPUT_TOKENS=8000
GEMINI_READ_TIMEOUT_S=90

# المهلة الكلية لتوليد التقرير
REPORT_TIMEOUT_S=140

# الكاش الذاكري (يقلّل الزمن واستهلاك Gemini)
CACHE_ENABLED=1
CACHE_TTL_REPORT_S=600      # 10 دقائق للتقرير النهائي
CACHE_TTL_UPSTREAM_S=900    # 15 دقيقة لبيانات Open-Meteo
CACHE_TTL_OVERPASS_S=86400  # 24 ساعة لاتجاه الشاطئ/نوع القاع
CACHE_TTL_FAILURE_S=60      # تذكّر الفشل المؤقت للخدمات الخارجية
CACHE_MAX_ENTRIES=512

# تحديد المعدّل (فعّله في الإنتاج، وعطّله في الاختبارات)
RATE_LIMIT_ENABLED=1
RATE_LIMIT_REPORT=1/minute
RATE_LIMIT_ORIENTATION=5/minute
RATE_LIMIT_BOTTOM=10/minute

# قائمة Origins المسموحة (افصل بفواصل). * = الكل (غير موصى به في الإنتاج)
ALLOWED_ORIGINS=*

LOG_LEVEL=INFO
